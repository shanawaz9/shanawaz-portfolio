{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "react-3000",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "react-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm install && npm start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "react-3005",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PORT=3005&& set BROWSER=none&& npm start"],
      "port": 3005
    }
  ]
}
